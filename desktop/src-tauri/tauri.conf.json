{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAAB",
  "version": "0.1.0",
  "identifier": "tech.softnetics.laab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LAAB",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' media: http://media.localhost https: data: blob:; media-src 'self' media: http://media.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "SocialNetworking",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "laab"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NUE3RTBEN0U5M0UxQUIKUldTcjRaTitEWDVhbEJiZHhPTjAwU3FHcG1uVktSdTJvTWFzRlJwNDM5bkJZb29Sc3QraEtqS1UK",
      "endpoints": [
        "https://github.com/softnetics/laab/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
