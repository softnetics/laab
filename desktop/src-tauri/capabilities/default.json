{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LAAB's own windows: the main window detached chat windows, aux windows and the photo viewer. LIFF windows load remote pages and get no permissions.",
  "windows": ["main", "chat-*", "aux-*", "viewer"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "window-state:default"
  ]
}
